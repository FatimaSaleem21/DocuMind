# Frontend environment. Copy to .env for local dev; set in Vercel/Netlify for prod.
# Vite bakes VITE_* vars in at BUILD time, so changing this requires a rebuild.

# Base URL of the backend API, including the /api prefix, no trailing slash.
# Local:      http://localhost:8000/api
# Production: https://<your-backend-host>/api
VITE_API_URL=http://localhost:8000/api