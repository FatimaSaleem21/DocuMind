# Backend environment variables. Copy to .env for local dev, or set these in
# your host's dashboard for production. .env itself is gitignored.

# Which settings module to load. Local/CI use base; deploys use production.
DJANGO_SETTINGS_MODULE=docuMind.settings.base

# --- Core (required in production; base has dev-safe fallbacks) ---
SECRET_KEY=change-me
# Comma-separated, no scheme. e.g. documind-web.up.railway.app
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated frontend origins (scheme + host, no trailing slash).
# Explicit allowlist — never CORS_ALLOW_ALL_ORIGINS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
# Production: a single connection string (Neon/Railway/Render style).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# Local/base: discrete vars (defaults shown).
POSTGRES_DB=docufind
POSTGRES_USER=docufind
POSTGRES_PASSWORD=docufind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Optional overrides (defaults shown):
# EMBEDDING_MODEL=text-embedding-3-small
# CHAT_MODEL=gpt-4o-mini
# CHAT_TIMEOUT_SECONDS=60

# --- Public-demo safeguard ---
# Per-IP daily cap on the streaming chat endpoint. 0 disables.
CHAT_DAILY_IP_LIMIT=50

# --- Media object storage (production only) ---
# S3-compatible: Cloudflare R2 / AWS S3 / Backblaze B2. Web + worker share this
# bucket since they run as separate containers with no shared filesystem.
# For B2, AWS_S3_REGION_NAME is the real region (e.g. us-east-005); for R2 it's "auto".
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=documind-media
# AWS_S3_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
# AWS_S3_REGION_NAME=us-east-005